const sqlite3 = require('sqlite3').verbose();
const path = require('path');

const dbPath = path.join(__dirname, 'casino-demo.db');
const db = new sqlite3.Database(dbPath);

function initializeDatabase() {
  db.serialize(() => {
    db.run(`
      CREATE TABLE IF NOT EXISTS users (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        username TEXT UNIQUE NOT NULL,
        password_hash TEXT NOT NULL,
        balance INTEGER NOT NULL DEFAULT 1000,
        created_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP
      )
    `);

    db.run(`
      CREATE TABLE IF NOT EXISTS game_history (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        user_id INTEGER NOT NULL,
        game_name TEXT NOT NULL,
        bet INTEGER NOT NULL,
        side TEXT,
        result TEXT,
        payout INTEGER NOT NULL DEFAULT 0,
        balance_after INTEGER NOT NULL,
        created_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP,
        FOREIGN KEY(user_id) REFERENCES users(id)
      )
    `);
  });
}

function runQuery(sql, params = []) {
  return new Promise((resolve, reject) => {
    db.run(sql, params, function onRun(err) {
      if (err) {
        reject(err);
      } else {
        resolve({ lastID: this.lastID, changes: this.changes });
      }
    });
  });
}

function getOne(sql, params = []) {
  return new Promise((resolve, reject) => {
    db.get(sql, params, (err, row) => {
      if (err) reject(err);
      else resolve(row);
    });
  });
}

function getAll(sql, params = []) {
  return new Promise((resolve, reject) => {
    db.all(sql, params, (err, rows) => {
      if (err) reject(err);
      else resolve(rows);
    });
  });
}

async function getUserByUsername(username) {
  return getOne('SELECT * FROM users WHERE username = ?', [username]);
}

async function getUserById(id) {
  return getOne('SELECT * FROM users WHERE id = ?', [id]);
}

async function createUser(username, passwordHash) {
  const result = await runQuery(
    'INSERT INTO users (username, password_hash, balance) VALUES (?, ?, 1000)',
    [username, passwordHash]
  );

  return getUserById(result.lastID);
}

async function updateBalance(userId, newBalance) {
  await runQuery('UPDATE users SET balance = ? WHERE id = ?', [newBalance, userId]);
  return getUserById(userId);
}

async function addHistory({ userId, gameName, bet, side, result, payout, balanceAfter }) {
  return runQuery(
    'INSERT INTO game_history (user_id, game_name, bet, side, result, payout, balance_after) VALUES (?, ?, ?, ?, ?, ?, ?)',
    [userId, gameName, bet, side || null, result || null, payout, balanceAfter]
  );
}

async function getHistory(userId, limit = 20) {
  return getAll(
    'SELECT * FROM game_history WHERE user_id = ? ORDER BY created_at DESC LIMIT ?',
    [userId, limit]
  );
}

module.exports = {
  db,
  initializeDatabase,
  getUserByUsername,
  getUserById,
  createUser,
  updateBalance,
  addHistory,
  getHistory
};
