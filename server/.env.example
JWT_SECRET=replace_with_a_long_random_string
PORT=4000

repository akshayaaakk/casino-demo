const jwt = require('jsonwebtoken');
const { getUserById, updateBalance } = require('./db');

module.exports = function setupAviator(io) {
  const roomName = 'aviator-room';

  const state = {
    round: 1,
    status: 'betting',
    multiplier: 1,
    crashAt: null,
    duration: null,
    bets: []
  };

  function emitState() {
    io.to(roomName).emit('aviator:update', {
      round: state.round,
      status: state.status,
      multiplier: state.multiplier,
      crashAt: state.crashAt,
      duration: state.duration,
      bets: state.bets.map((bet) => ({
        userId: bet.userId,
        username: bet.username,
        amount: bet.amount,
        cashoutMultiplier: bet.cashoutMultiplier
      }))
    });
  }

  function completeRound() {
    const roundBets = [...state.bets];
    state.bets = [];

    for (const bet of roundBets) {
      if (bet.cashoutMultiplier) {
        const payout = Math.round(bet.amount * bet.cashoutMultiplier);
        getUserById(bet.userId).then(async (user) => {
          if (!user) return;
          const newBalance = user.balance + payout;
          await updateBalance(bet.userId, newBalance);
          io.to(roomName).emit('aviator:result', {
            username: bet.username,
            amount: bet.amount,
            payout,
            multiplier: bet.cashoutMultiplier,
            balance: newBalance
          });
        }).catch((error) => {
          console.error('Aviator payout error:', error);
        });
      }
    }

    state.round += 1;
    state.status = 'betting';
    state.multiplier = 1;
    state.crashAt = null;
    state.duration = null;

    setTimeout(() => {
      startRound();
    }, 5000);

    emitState();
  }

  function startRound() {
    state.status = 'betting';
    state.multiplier = 1;
    state.crashAt = null;
    state.duration = null;
    state.bets = [];
    emitState();

    setTimeout(() => {
      const crashAt = Number((1 + Math.random() * 3.4 + Math.random() * 1.5).toFixed(2));
      const startTime = Date.now();
      state.status = 'flight';
      state.crashAt = crashAt;
      state.duration = 0;
      emitState();

      const flightTimer = setInterval(() => {
        const elapsed = (Date.now() - startTime) / 1000;
        const nextMultiplier = Number((1 + elapsed * 0.9 + Math.random() * 0.25).toFixed(2));
        state.multiplier = Math.min(nextMultiplier, crashAt);
        state.duration = elapsed;

        if (nextMultiplier >= crashAt) {
          state.multiplier = crashAt;
          state.status = 'crashed';
          clearInterval(flightTimer);
          emitState();
          completeRound();
        } else {
          emitState();
        }
      }, 100);
    }, 15000);
  }

  io.on('connection', (socket) => {
    socket.join(roomName);
    socket.emit('aviator:update', {
      round: state.round,
      status: state.status,
      multiplier: state.multiplier,
      crashAt: state.crashAt,
      duration: state.duration,
      bets: state.bets
    });

    socket.on('auth', (token) => {
      if (!token) return;

      try {
        const decoded = jwt.verify(token, process.env.JWT_SECRET || 'demo-secret');
        socket.data.user = {
          id: decoded.userId,
          username: decoded.username
        };
      } catch (error) {
        socket.emit('aviator:error', 'Your session expired. Please log in again.');
      }
    });

    socket.on('place-bet', async ({ amount }) => {
      const user = socket.data.user;
      if (!user) {
        socket.emit('aviator:error', 'Log in to place a bet.');
        return;
      }

      if (state.status !== 'betting') {
        socket.emit('aviator:error', 'Bets are closed for this round.');
        return;
      }

      const betAmount = Number(amount);
      if (!Number.isFinite(betAmount) || betAmount <= 0 || betAmount % 1 !== 0) {
        socket.emit('aviator:error', 'Bet must be a positive whole number.');
        return;
      }

      const persistedUser = await getUserById(user.id);
      if (!persistedUser) {
        socket.emit('aviator:error', 'Account not found.');
        return;
      }

      if (persistedUser.balance < betAmount) {
        socket.emit('aviator:error', 'Not enough demo chips for that bet.');
        return;
      }

      const existingBet = state.bets.find((entry) => entry.userId === user.id);
      if (existingBet) {
        socket.emit('aviator:error', 'You already placed a bet for this round.');
        return;
      }

      const updatedUser = await updateBalance(user.id, persistedUser.balance - betAmount);
      state.bets.push({
        userId: user.id,
        username: user.username,
        amount: betAmount,
        cashoutMultiplier: null,
        balance: updatedUser.balance
      });

      io.to(roomName).emit('aviator:balance', {
        userId: user.id,
        username: user.username,
        balance: updatedUser.balance
      });

      emitState();
    });

    socket.on('cash-out', async () => {
      const user = socket.data.user;
      if (!user) {
        socket.emit('aviator:error', 'Log in to cash out.');
        return;
      }

      if (state.status !== 'flight') {
        socket.emit('aviator:error', 'You can only cash out while the flight is active.');
        return;
      }

      const activeBet = state.bets.find((entry) => entry.userId === user.id && entry.cashoutMultiplier === null);
      if (!activeBet) {
        socket.emit('aviator:error', 'No active Aviator bet found.');
        return;
      }

      activeBet.cashoutMultiplier = Number(state.multiplier.toFixed(2));
      const payout = Math.round(activeBet.amount * activeBet.cashoutMultiplier);
      const player = await getUserById(user.id);
      const updatedBalance = (player?.balance || 0) + payout;

      await updateBalance(user.id, updatedBalance);
      socket.emit('aviator:cashout', {
        username: user.username,
        payout,
        multiplier: activeBet.cashoutMultiplier,
        balance: updatedBalance
      });

      emitState();
    });
  });

  startRound();
};
